<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>카드 뒤집기 가챠 게임</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        
        body {
            background: linear-gradient(135deg, #6a11cb 0%, #2575fc 100%);
            min-height: 100vh;
            padding: 20px;
            color: white;
        }
        
        .container {
            max-width: 1200px;
            margin: 0 auto;
        }
        
        header {
            text-align: center;
            padding: 20px 0;
            margin-bottom: 30px;
            animation: fadeIn 1s ease-in;
        }
        
        h1 {
            font-size: 2.8rem;
            margin-bottom: 10px;
            text-shadow: 0 2px 4px rgba(0, 0, 0, 0.3);
            background: linear-gradient(to right, #ffcc00, #ff9900);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
        }
        
        .subtitle {
            font-size: 1.2rem;
            opacity: 0.9;
            max-width: 600px;
            margin: 0 auto;
            line-height: 1.6;
        }
        
        .game-container {
            display: flex;
            flex-direction: column;
            gap: 30px;
        }
        
        .input-section {
            background: rgba(255, 255, 255, 0.1);
            border-radius: 15px;
            padding: 25px;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.2);
            backdrop-filter: blur(10px);
        }
        
        .input-section h2 {
            margin-bottom: 15px;
            font-size: 1.5rem;
            color: #ffcc00;
        }
        
        .input-group {
            display: flex;
            flex-direction: column;
            gap: 15px;
        }
        
        textarea {
            width: 100%;
            height: 150px;
            padding: 15px;
            border-radius: 10px;
            border: 2px solid rgba(255, 255, 255, 0.3);
            background: rgba(255, 255, 255, 0.1);
            color: white;
            font-size: 1rem;
            resize: vertical;
        }
        
        textarea::placeholder {
            color: rgba(255, 255, 255, 0.6);
        }
        
        .button-group {
            display: flex;
            gap: 15px;
            margin-top: 10px;
        }
        
        button {
            padding: 12px 25px;
            border: none;
            border-radius: 50px;
            background: linear-gradient(to right, #ffcc00, #ff9900);
            color: #333;
            font-weight: bold;
            font-size: 1rem;
            cursor: pointer;
            transition: all 0.3s ease;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
        }
        
        button:hover {
            transform: translateY(-3px);
            box-shadow: 0 6px 20px rgba(0, 0, 0, 0.3);
            background: linear-gradient(to right, #ffd54f, #ffb300);
        }
        
        .card-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
            margin-top: 10px;
        }
        
        @media (min-width: 768px) {
            .card-grid {
                grid-template-columns: repeat(4, 1fr);
            }
        }
        
        @media (min-width: 1024px) {
            .card-grid {
                grid-template-columns: repeat(5, 1fr);
            }
        }
        
        .card {
            position: relative;
            height: 180px;
            perspective: 1000px;
            cursor: pointer;
            transition: transform 0.3s;
        }
        
        .card:hover {
            transform: scale(1.03);
        }
        
        .card-inner {
            position: relative;
            width: 100%;
            height: 100%;
            text-align: center;
            transition: transform 0.6s;
            transform-style: preserve-3d;
        }
        
        .card.flipped .card-inner {
            transform: rotateY(180deg);
        }
        
        .card-front, .card-back {
            position: absolute;
            width: 100%;
            height: 100%;
            backface-visibility: hidden;
            border-radius: 15px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            padding: 15px;
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.3);
            overflow: hidden;
        }
        
        .card-front {
            background: linear-gradient(135deg, #ff9a9e 0%, #fad0c4 100%);
            transform: rotateY(0deg);
        }
        
        .card-back {
            background: linear-gradient(135deg, #a1c4fd 0%, #c2e9fb 100%);
            transform: rotateY(180deg);
        }
        
        .card-icon {
            font-size: 3rem;
            margin-bottom: 15px;
        }
        
        .card-title {
            font-size: 1.2rem;
            font-weight: bold;
            margin-bottom: 10px;
            color: #333;
            text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.2);
        }
        
        .card-description {
            font-size: 0.9rem;
            color: #555;
            line-height: 1.4;
        }
        
        .modal {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.8);
            display: flex;
            justify-content: center;
            align-items: center;
            z-index: 1000;
            opacity: 0;
            visibility: hidden;
            transition: opacity 0.4s, visibility 0.4s;
        }
        
        .modal.active {
            opacity: 1;
            visibility: visible;
        }
        
        .modal-content {
            background: linear-gradient(135deg, #ffcc00 0%, #ff9900 100%);
            padding: 40px;
            border-radius: 20px;
            text-align: center;
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.5);
            max-width: 90%;
            width: 400px;
            animation: modalAnim 0.6s ease-out;
        }
        
        @keyframes modalAnim {
            0% { transform: scale(0.5); opacity: 0; }
            100% { transform: scale(1); opacity: 1; }
        }
        
        .modal-icon {
            font-size: 5rem;
            margin-bottom: 20px;
            animation: bounce 1s infinite;
        }
        
        .modal-title {
            font-size: 2.2rem;
            margin-bottom: 15px;
            color: #333;
            text-shadow: 0 2px 4px rgba(0, 0, 0, 0.2);
        }
        
        .modal-text {
            font-size: 1.2rem;
            margin-bottom: 25px;
            color: #333;
            line-height: 1.6;
        }
        
        .modal-button {
            padding: 15px 40px;
            font-size: 1.2rem;
            background: #333;
            color: white;
            border: none;
            border-radius: 50px;
            cursor: pointer;
            transition: all 0.3s ease;
            font-weight: bold;
        }
        
        .modal-button:hover {
            background: #555;
            transform: scale(1.05);
        }
        
        .instructions {
            background: rgba(255, 255, 255, 0.1);
            border-radius: 15px;
            padding: 20px;
            margin-top: 30px;
            backdrop-filter: blur(5px);
        }
        
        .instructions h3 {
            color: #ffcc00;
            margin-bottom: 15px;
            font-size: 1.3rem;
        }
        
        .instructions ul {
            padding-left: 20px;
        }
        
        .instructions li {
            margin-bottom: 10px;
            line-height: 1.5;
        }
        
        .stats {
            display: flex;
            justify-content: space-around;
            background: rgba(255, 255, 255, 0.1);
            border-radius: 15px;
            padding: 20px;
            margin-top: 20px;
            backdrop-filter: blur(5px);
        }
        
        .stat-item {
            text-align: center;
        }
        
        .stat-value {
            font-size: 2rem;
            font-weight: bold;
            color: #ffcc00;
            margin: 5px 0;
        }
        
        .stat-label {
            font-size: 0.9rem;
            opacity: 0.8;
        }
        
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(-20px); }
            to { opacity: 1; transform: translateY(0); }
        }
        
        @keyframes bounce {
            0%, 20%, 50%, 80%, 100% {transform: translateY(0);}
            40% {transform: translateY(-20px);}
            60% {transform: translateY(-10px);}
        }
        
        .card-disabled {
            pointer-events: none;
            opacity: 0.6;
        }
        
        .card-disabled .card-front {
            background: linear-gradient(135deg, #e0e0e0 0%, #b0b0b0 100%);
        }
        
        .loading {
            display: none;
            text-align: center;
            padding: 20px;
            color: #ffcc00;
        }
        
        .loading.active {
            display: block;
            animation: pulse 1.5s infinite;
        }
        
        @keyframes pulse {
            0% { opacity: 0.6; }
            50% { opacity: 1; }
            100% { opacity: 0.6; }
        }
    </style>
</head>
<body>
    <div class="container">
        <header>
            <h1>✨ 카드 뒤집기 가챠 게임 ✨</h1>
            <p class="subtitle">카드를 클릭해 뒤집고 특별한 상자를 얻으세요! 가중치에 따라 당첨 확률이 달라집니다.</p>
        </header>
        
        <div class="game-container">
            <div class="input-section">
                <h2>카드 설정</h2>
                <div class="input-group">
                    <textarea id="cardData" placeholder="이름|가중치|재고 형식으로 입력하세요 (예: 금화|10|5)"></textarea>
                    <div class="button-group">
                        <button id="loadBtn">카드 로드</button>
                        <button id="resetBtn">리셋</button>
                    </div>
                </div>
                
                <div class="loading" id="loading">로딩 중...</div>
            </div>
            
            <div class="stats">
                <div class="stat-item">
                    <div class="stat-value" id="totalCards">0</div>
                    <div class="stat-label">총 카드</div>
                </div>
                <div class="stat-item">
                    <div class="stat-value" id="remainingCards">0</div>
                    <div class="stat-label">남은 카드</div>
                </div>
                <div class="stat-item">
                    <div class="stat-value" id="totalPulls">0</div>
                    <div class="stat-label">총 뽑기</div>
                </div>
            </div>
            
            <div class="instructions">
                <h3>게임 방법</h3>
                <ul>
                    <li>이름|가중치|재고 형식으로 카드 데이터를 입력하세요</li>
                    <li>비어 있는 경우 기본값: 가중치=1, 재고=무한</li>
                    <li>카드를 클릭하면 3D 뒤집기 애니메이션이 실행됩니다</li>
                    <li>뒤집힌 카드가 당첨되면 상단에 모달이 나타납니다</li>
                    <li>재고가 0인 카드는 사용할 수 없습니다</li>
                </ul>
            </div>
            
            <div class="card-grid" id="cardGrid"></div>
        </div>
    </div>
    
    <div class="modal" id="winModal">
        <div class="modal-content">
            <div class="modal-icon">🎉</div>
            <h2 class="modal-title">뿅!</h2>
            <p class="modal-text" id="winMessage">특별한 상자를 얻었습니다!</p>
            <button class="modal-button" id="closeModal">확인</button>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            // DOM 요소
            const cardDataInput = document.getElementById('cardData');
            const loadBtn = document.getElementById('loadBtn');
            const resetBtn = document.getElementById('resetBtn');
            const cardGrid = document.getElementById('cardGrid');
            const winModal = document.getElementById('winModal');
            const closeModal = document.getElementById('closeModal');
            const winMessage = document.getElementById('winMessage');
            const totalCardsEl = document.getElementById('totalCards');
            const remainingCardsEl = document.getElementById('remainingCards');
            const totalPullsEl = document.getElementById('totalPulls');
            const loadingEl = document.getElementById('loading');
            
            // 게임 상태
            let cards = [];
            let totalPulls = 0;
            
            // 초기화
            function init() {
                totalPulls = 0;
                updateStats();
                renderCards([]);
            }
            
            // 카드 데이터 파싱
            function parseCardData(data) {
                const lines = data.trim().split('\n');
                const parsedCards = [];
                
                for (let line of lines) {
                    if (!line.trim()) continue;
                    
                    const parts = line.split('|').map(part => part.trim());
                    
                    if (parts.length < 1) continue;
                    
                    const name = parts[0] || '알 수 없는 카드';
                    const weight = parts.length >= 2 && parts[1] !== '' ? parseInt(parts[1]) : 1;
                    const stock = parts.length >= 3 && parts[2] !== '' ? parseInt(parts[2]) : Infinity;
                    
                    parsedCards.push({
                        id: Date.now() + Math.random(),
                        name,
                        weight,
                        stock,
                        flipped: false,
                        disabled: false
                    });
                }
                
                return parsedCards;
            }
            
            // 카드 생성
            function createCardElement(card) {
                const cardEl = document.createElement('div');
                cardEl.className = 'card';
                cardEl.dataset.id = card.id;
                
                if (card.disabled) {
                    cardEl.classList.add('card-disabled');
                }
                
                cardEl.innerHTML = `
                    <div class="card-inner">
                        <div class="card-front">
                            <div class="card-icon">❓</div>
                            <div class="card-title">카드 뒤집기</div>
                            <div class="card-description">클릭하여 뒤집기</div>
                        </div>
                        <div class="card-back">
                            <div class="card-icon">${getCardIcon(card.name)}</div>
                            <div class="card-title">${card.name}</div>
                            <div class="card-description">${getCardDescription(card.name)}</div>
                        </div>
                    </div>
                `;
                
                cardEl.addEventListener('click', () => handleCardClick(card, cardEl));
                
                return cardEl;
            }
            
            // 카드 아이콘 매핑
            function getCardIcon(name) {
                const iconMap = {
                    '금화': '💰',
                    '은화': '🪙',
                    '보석': '💎',
                    '다이아': '💠',
                    '특별상자': '🎁',
                    '레어카드': '✨',
                    '기본카드': '📄'
                };
                
                return iconMap[name] || '🎉';
            }
            
            // 카드 설명 생성
            function getCardDescription(name) {
                const descMap = {
                    '금화': '가치 있는 보상입니다!',
                    '은화': '중간 정도의 보상입니다.',
                    '보석': '고급 보상입니다.',
                    '다이아': '최상급 보상입니다!',
                    '특별상자': '특별한 아이템이 들어있습니다.',
                    '레어카드': '드문 카드입니다.',
                    '기본카드': '일반적인 카드입니다.'
                };
                
                return descMap[name] || '카드 설명';
            }
            
            // 카드 렌더링
            function renderCards(cardList) {
                cardGrid.innerHTML = '';
                
                if (cardList.length === 0) {
                    cardGrid.innerHTML = '<p style="grid-column: 1 / -1; text-align: center; padding: 20px;">카드를 로드해 주세요!</p>';
                    return;
                }
                
                cardList.forEach(card => {
                    cardGrid.appendChild(createCardElement(card));
                });
            }
            
            // 카드 클릭 처리
            function handleCardClick(card, cardEl) {
                if (card.disabled || card.flipped) return;
                
                // 애니메이션 클래스 추가
                cardEl.classList.add('flipped');
                card.flipped = true;
                
                // 당첨 로직
                setTimeout(() => {
                    const winner = drawCard();
                    
                    if (winner) {
                        showWinModal(winner);
                    } else {
                        // 모든 카드가 소진된 경우
                        winMessage.textContent = "모든 카드를 모두 뽑았습니다!";
                        winModal.classList.add('active');
                    }
                    
                    // 카드 상태 업데이트
                    updateCardState(card);
                }, 600);
            }
            
            // 카드 상태 업데이트
            function updateCardState(card) {
                // 재고 감소
                if (card.stock !== Infinity) {
                    card.stock--;
                    
                    if (card.stock <= 0) {
                        card.disabled = true;
                        const cardEl = document.querySelector(`.card[data-id="${card.id}"]`);
                        if (cardEl) {
                            cardEl.classList.add('card-disabled');
                        }
                    }
                }
                
                updateStats();
            }
            
            // 당첨 로직
            function drawCard() {
                totalPulls++;
                updateStats();
                
                // 가중치 계산
                let totalWeight = 0;
                cards.forEach(card => {
                    if (!card.disabled) {
                        totalWeight += card.weight;
                    }
                });
                
                if (totalWeight === 0) {
                    return null;
                }
                
                // 랜덤 값 생성
                const random = Math.random() * totalWeight;
                let cumulative = 0;
                
                for (let card of cards) {
                    if (card.disabled) continue;
                    
                    cumulative += card.weight;
                    if (random <= cumulative) {
                        return card;
                    }
                }
                
                return null;
            }
            
            // 모달 표시
            function showWinModal(winner) {
                winMessage.textContent = `"${winner.name}" 카드를 얻었습니다! (${winner.stock !== Infinity ? `재고: ${winner.stock}` : '무한'} 남음)`;
                winModal.classList.add('active');
            }
            
            // 모달 닫기
            closeModal.addEventListener('click', () => {
                winModal.classList.remove('active');
            });
            
            // 통계 업데이트
            function updateStats() {
                const total = cards.length;
                const remaining = cards.filter(card => !card.disabled).length;
                
                totalCardsEl.textContent = total;
                remainingCardsEl.textContent = remaining;
                totalPullsEl.textContent = totalPulls;
            }
            
            // 이벤트 리스너
            loadBtn.addEventListener('click', () => {
                const data = cardDataInput.value;
                if (!data.trim()) {
                    alert('카드 데이터를 입력해주세요!');
                    return;
                }
                
                loadingEl.classList.add('active');
                
                setTimeout(() => {
                    cards = parseCardData(data);
                    renderCards(cards);
                    updateStats();
                    loadingEl.classList.remove('active');
                }, 800);
            });
            
            resetBtn.addEventListener('click', () => {
                if (confirm('모든 설정을 초기화하시겠습니까?')) {
                    cardDataInput.value = '';
                    init();
                }
            });
            
            // 초기화
            init();
        });
    </script>
</body>
</html>
