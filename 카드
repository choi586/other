<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>카드 뒤집기 경품 추첨</title>
    
    <style>
        body {
            font-family: 'Arial', sans-serif;
            background-color: #f4f7f6;
            color: #333;
            display: flex;
            justify-content: center;
            padding: 20px;
        }

        .container {
            background-color: #fff;
            padding: 30px;
            border-radius: 10px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
            max-width: 900px;
            width: 100%;
        }

        h1 {
            text-align: center;
            color: #007bff;
            margin-bottom: 20px;
        }

        /* 탭 스타일 */
        .tabs {
            display: flex;
            justify-content: center;
            margin-bottom: 20px;
        }

        .tab-button {
            background-color: #e9ecef;
            border: none;
            padding: 10px 20px;
            cursor: pointer;
            font-size: 16px;
            transition: background-color 0.3s, color 0.3s;
            border-radius: 5px 5px 0 0;
            margin: 0 5px;
        }

        .tab-button:hover {
            background-color: #dee2e6;
        }

        .tab-button.active {
            background-color: #007bff;
            color: white;
        }

        .tab-content {
            padding: 20px;
            border: 1px solid #dee2e6;
            border-radius: 0 0 5px 5px;
            display: none; /* 기본적으로 숨김 */
        }

        .tab-content.active {
            display: block; /* 활성화된 탭만 표시 */
        }

        /* 재고 관리 스타일 */
        #prize-list div {
            padding: 10px;
            margin-bottom: 8px;
            border-bottom: 1px solid #eee;
            display: flex;
            justify-content: space-between;
            align-items: center;
            background-color: #f8f9fa;
            border-radius: 4px;
        }

        .add-prize {
            margin-top: 20px;
            display: flex;
            gap: 10px;
        }

        .add-prize input, .add-prize button {
            padding: 10px;
            border: 1px solid #ccc;
            border-radius: 4px;
            flex-grow: 1;
        }
        
        .add-prize input[type="text"] { flex-grow: 2; }
        .add-prize input[type="number"] { flex-grow: 1; max-width: 100px; }
        .add-prize button {
            background-color: #28a745;
            color: white;
            cursor: pointer;
            border: none;
            flex-grow: 1;
        }

        /* 카드 영역 스타일 */
        #card-area {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 20px;
            margin-top: 30px;
        }

        .card-container {
            perspective: 1000px; /* 3D 효과를 위한 원근법 설정 */
            width: 150px;
            height: 200px;
            cursor: pointer;
        }

        .card {
            width: 100%;
            height: 100%;
            position: relative;
            transition: transform 0.6s;
            transform-style: preserve-3d;
        }

        .card.flipped {
            transform: rotateY(180deg);
        }

        .card-face {
            position: absolute;
            width: 100%;
            height: 100%;
            backface-visibility: hidden; /* 뒤집었을 때 뒷면이 보이지 않도록 */
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
            font-weight: bold;
            color: white;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
        }

        .card-front {
            background-color: #dc3545; /* 카드 뒷면 (선택 전) */
            transform: rotateY(0deg);
            font-size: 40px;
        }

        .card-back {
            background-color: #ffc107; /* 경품 내용 배경색 */
            transform: rotateY(180deg);
            padding: 10px;
            text-align: center;
            word-break: break-all;
            font-size: 16px;
            color: #333; /* 경품 내용은 어두운 색으로 */
        }

        .card-back.win {
            background-color: #28a745; /* 당첨 경품 */
            color: white;
        }

        .card-back.lose {
            background-color: #f0f0f0; /* 꽝 */
            color: #6c757d;
        }

        /* 재고 수정 버튼 */
        .stock-btn {
            margin-left: 5px;
            padding: 3px 8px;
            border: none;
            border-radius: 3px;
            cursor: pointer;
        }

        .increase-btn { background-color: #007bff; color: white; }
        .decrease-btn { background-color: #dc3545; color: white; }
    </style>
</head>
<body>
    <div class="container">
        <h1>🎉 카드 뒤집기 경품 추첨 이벤트 🎉</h1>

        <div class="tabs">
            <button class="tab-button active" onclick="openTab(event, 'inventory')">재고 관리 📦</button>
            <button class="tab-button" onclick="openTab(event, 'drawing')">경품 추첨 🍀</button>
        </div>

        <div id="inventory" class="tab-content active">
            <h2>경품 재고 관리</h2>
            <div id="prize-list">
                </div>
            <div class="add-prize">
                <input type="text" id="prize-name" placeholder="경품 이름">
                <input type="number" id="prize-stock" placeholder="수량" min="0">
                <button onclick="addPrize()">경품 추가/수량 합산</button>
            </div>
        </div>

        <div id="drawing" class="tab-content">
            <h2>카드 추첨</h2>
            <p id="drawing-status">경품 추첨을 시작하려면 '경품 추첨' 탭을 눌러 카드를 생성해주세요.</p>
            <div id="card-area">
                </div>
        </div>
    </div>

    <script>
        // 전역 변수로 경품 재고를 관리합니다.
        // { name: '경품 이름', stock: 수량 } 형태의 배열입니다.
        let prizes = [
            { name: '아이패드 미니', stock: 1 },
            { name: '스타벅스 쿠폰', stock: 5 },
            { name: '꽝 😂', stock: 999 } // 꽝은 재고 제한 없이 무한대로 설정
        ];
        const NUM_CARDS = 9; // 추첨에 사용할 카드의 총 개수

        // 초기화 시 재고 목록을 화면에 표시합니다.
        document.addEventListener('DOMContentLoaded', () => {
            renderPrizeList();
            // 경품 추첨 탭이 활성화되었을 때만 카드를 생성
            if (document.getElementById('drawing').classList.contains('active')) {
                generateCards();
            }
        });

        /* -------------------- 탭 기능 -------------------- */

        function openTab(evt, tabName) {
            let i, tabcontent, tabbuttons;

            // 모든 탭 컨텐츠 숨기기
            tabcontent = document.getElementsByClassName("tab-content");
            for (i = 0; i < tabcontent.length; i++) {
                tabcontent[i].classList.remove("active");
            }

            // 모든 탭 버튼에서 'active' 클래스 제거
            tabbuttons = document.getElementsByClassName("tab-button");
            for (i = 0; i < tabbuttons.length; i++) {
                tabbuttons[i].classList.remove("active");
            }

            // 현재 탭 컨텐츠 표시 및 버튼 활성화
            document.getElementById(tabName).classList.add("active");
            evt.currentTarget.classList.add("active");

            // 경품 추첨 탭으로 이동할 때마다 카드를 새로 생성합니다.
            if (tabName === 'drawing') {
                generateCards();
            }
        }

        /* -------------------- 재고 관리 기능 -------------------- */

        function renderPrizeList() {
            const listDiv = document.getElementById('prize-list');
            listDiv.innerHTML = '';

            prizes.forEach((prize, index) => {
                const itemDiv = document.createElement('div');
                itemDiv.innerHTML = `
                    <span>${prize.name}: <strong>${prize.stock}</strong>개</span>
                    <div>
                        <button class="stock-btn increase-btn" onclick="updateStock(${index}, 1)">+</button>
                        <button class="stock-btn decrease-btn" onclick="updateStock(${index}, -1)">-</button>
                    </div>
                `;
                listDiv.appendChild(itemDiv);
            });
        }

        function addPrize() {
            const nameInput = document.getElementById('prize-name');
            const stockInput = document.getElementById('prize-stock');
            const name = nameInput.value.trim();
            const stock = parseInt(stockInput.value, 10);

            if (name && !isNaN(stock) && stock >= 0) {
                // 이미 있는 경품인지 확인
                const existingPrize = prizes.find(p => p.name === name);
                if (existingPrize) {
                    existingPrize.stock += stock;
                } else {
                    prizes.push({ name: name, stock: stock });
                }
                
                nameInput.value = '';
                stockInput.value = '';
                renderPrizeList();
            } else {
                alert('경품 이름과 0 이상의 수량을 정확히 입력해주세요.');
            }
        }

        function updateStock(index, delta) {
            const prize = prizes[index];
            if (prize.stock + delta >= 0) {
                prize.stock += delta;
                renderPrizeList();
                // 추첨 탭이 활성화된 경우에만 카드 갱신
                if (document.getElementById('drawing').classList.contains('active')) {
                    generateCards(); 
                }
            } else {
                alert('재고는 0개 미만이 될 수 없습니다.');
            }
        }

        /* -------------------- 경품 추첨 기능 -------------------- */

        function generateCards() {
            const cardArea = document.getElementById('card-area');
            cardArea.innerHTML = '';
            
            // 1. 추첨 가능한 경품 목록 (재고 > 0 인 경품만)
            const availablePrizes = prizes.filter(p => p.stock > 0);

            // 2. 당첨 경품 선정 로직
            let winningPrize = '꽝 😂'; // 기본값은 꽝
            
            // 꽝 경품 정보를 찾아둡니다.
            const losePrize = prizes.find(p => p.name === '꽝 😂');
            
            // 재고가 있는 경품이 하나라도 있으면 당첨 기회를 부여합니다.
            if (availablePrizes.length > 0 && losePrize) {
                
                // 꽝을 제외한 재고 총합
                const realStockSum = availablePrizes
                                    .filter(p => p.name !== '꽝 😂')
                                    .reduce((sum, p) => sum + p.stock, 0);
                
                // 전체 가중치 합산 (실 경품 재고 + 꽝 재고)
                const totalWeight = realStockSum + losePrize.stock;
                let rand = Math.floor(Math.random() * totalWeight);
                
                // 가중치에 따라 당첨 경품 결정
                for(const prize of availablePrizes) {
                    if (rand < prize.stock) {
                        winningPrize = prize.name;
                        break;
                    }
                    rand -= prize.stock;
                }
            }
            
            // 3. 카드에 할당할 내용 배열 생성 (당첨 경품 1개, 나머지는 꽝)
            const cardContents = [];
            
            // 당첨 경품 1개 삽입
            cardContents.push(winningPrize);

            // 나머지 카드에 꽝 삽입
            for (let i = 1; i < NUM_CARDS; i++) {
                cardContents.push('꽝 😂');
            }

            // 배열 무작위 섞기 (Fisher-Yates 알고리즘)
            for (let i = cardContents.length - 1; i > 0; i--) {
                const j = Math.floor(Math.random() * (i + 1));
                [cardContents[i], cardContents[j]] = [cardContents[j], cardContents[i]];
            }

            // 4. 카드 생성
            cardContents.forEach((content, index) => {
                const container = document.createElement('div');
                container.classList.add('card-container');
                container.innerHTML = `
                    <div class="card" id="card-${index}" onclick="flipCard(this, '${content}')">
                        <div class="card-face card-front">
                            ?
                        </div>
                        <div class="card-face card-back ${content === '꽝 😂' ? 'lose' : 'win'}">
                            ${content}
                        </div>
                    </div>
                `;
                cardArea.appendChild(container);
            });

            document.getElementById('drawing-status').textContent = '카드를 한 장 선택해주세요!';
            
            // 다시 추첨하기 버튼이 남아있다면 제거
            const existingBtn = document.getElementById('restart-btn');
            if (existingBtn) existingBtn.remove();
        }

        function flipCard(cardElement, prizeName) {
            const cardArea = document.getElementById('card-area');
            
            // 이미 뒤집힌 카드가 있으면 더 이상 진행하지 않습니다.
            if (cardArea.classList.contains('drawing-done')) {
                return;
            }

            // 1. 카드 뒤집기 애니메이션
            cardElement.classList.add('flipped');
            cardArea.classList.add('drawing-done'); // 추첨 완료 상태 설정

            // 2. 경품 처리 (당첨된 경우에만 재고 차감)
            setTimeout(() => { // 애니메이션 후 메시지 표시
                let resultMessage;
                if (prizeName !== '꽝 😂') {
                    resultMessage = `🎊 축하합니다! [${prizeName}]에 당첨되셨습니다! 🎊`;
                    
                    // 재고 차감
                    const winnerPrize = prizes.find(p => p.name === prizeName);
                    if (winnerPrize) {
                        winnerPrize.stock--;
                        renderPrizeList(); // 재고 목록 갱신
                    }
                } else {
                    resultMessage = '😭 아쉽지만 다음 기회에! [꽝]이네요.';
                }
                document.getElementById('drawing-status').textContent = resultMessage;

                // 3. 다시 뽑기 버튼 생성
                const restartButton = document.createElement('button');
                restartButton.textContent = '다시 추첨하기';
                restartButton.id = 'restart-btn';
                restartButton.style.marginTop = '20px';
                restartButton.style.padding = '10px 20px';
                restartButton.style.backgroundColor = '#007bff';
                restartButton.style.color = 'white';
                restartButton.style.border = 'none';
                restartButton.style.borderRadius = '5px';
                restartButton.style.cursor = 'pointer';
                restartButton.onclick = function() {
                    cardArea.classList.remove('drawing-done');
                    generateCards(); // 카드 재생성 및 추첨 초기화
                    restartButton.remove();
                };

                const statusElement = document.getElementById('drawing-status');
                statusElement.parentNode.insertBefore(restartButton, cardArea); // 카드 영역 위에 버튼 삽입
                
            }, 600); // CSS transition 시간과 맞춰줍니다.
        }
    </script>
</body>
</html>
